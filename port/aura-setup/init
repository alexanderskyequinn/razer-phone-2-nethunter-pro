#!/bin/sh
export PATH=/bin
/bin/busybox --install -s /bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
exec >/dev/kmsg 2>&1
fail() {
    echo "AURA_RELEASE: $*; returning to Download Mode"
    sleep 5
    /bin/return-to-bootloader --bootloader
    poweroff -f
    while :; do sleep 10; done
}
tr '\000' '\n' </proc/device-tree/compatible | grep -qx 'razer,aura' || fail 'unsupported phone'
mount -t tmpfs -o mode=0755 tmpfs /run || fail 'runtime mount'
mkdir -p /newroot
rootdev=
for attempt in $(seq 1 30); do
    mdev -s
    for node in /sys/class/block/*/uevent; do
        if grep -qx PARTNAME=userdata "$node"; then
            rootdev=/dev/$(basename "$(dirname "$node")")
            break
        fi
    done
    [ -n "$rootdev" ] && break
    sleep 1
done
[ -b "$rootdev" ] || fail 'userdata not found'
blkid "$rootdev" | grep -q 'TYPE="ext4"' || fail 'userdata is not ext4'
mount -t ext4 -o ro "$rootdev" /newroot || fail 'root mount'
grep -qx 'AURA_NATIVE_RELEASE=1' /newroot/etc/aura-release || fail 'not a native Aura installation'
mount -o remount,rw /newroot || fail 'writable root'
mkdir -p /newroot/dev /newroot/proc /newroot/sys /newroot/run
mount --move /dev /newroot/dev || fail 'move dev'
mount --move /sys /newroot/sys || fail 'move sys'
mount --move /proc /newroot/proc || fail 'move proc'
mount --move /run /newroot/run || fail 'move run'
exec switch_root /newroot /sbin/init
