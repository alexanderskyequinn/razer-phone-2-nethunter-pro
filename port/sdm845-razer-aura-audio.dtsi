/* Razer RC2 routing and voltages from the captured stock device tree. */
#include <dt-bindings/sound/qcom,q6afe.h>
#include <dt-bindings/sound/qcom,q6asm.h>
#include "sdm845-wcd9340.dtsi"

&adsp_pas {
	status = "okay";
	firmware-name = "qcom/sdm845/razer/aura/adsp.mdt";
};

&q6asmdai {
	dai@0 { reg = <MSM_FRONTEND_DAI_MULTIMEDIA1>; };
	dai@1 { reg = <MSM_FRONTEND_DAI_MULTIMEDIA2>; };
};
&q6afedai {
	dai@22 { reg = <QUATERNARY_MI2S_RX>; qcom,sd-lines = <1>; };
	dai@23 { reg = <QUATERNARY_MI2S_TX>; qcom,sd-lines = <0>; };
};

&wcd9340 {
	reset-gpios = <&tlmm 64 GPIO_ACTIVE_HIGH>;
	vdd-buck-supply = <&vreg_s4a>;
	vdd-buck-sido-supply = <&vreg_s4a>;
	vdd-tx-supply = <&vreg_s4a>;
	vdd-rx-supply = <&vreg_s4a>;
	vdd-io-supply = <&vreg_s4a>;
};

&i2c5 {
	status = "okay";
	clock-frequency = <400000>;
	aura_amp0: amplifier@34 {
		compatible = "tfa,tfa98xx";
		reg = <0x34>;
		#sound-dai-cells = <1>;
	};
	aura_amp1: amplifier@35 {
		compatible = "tfa,tfa98xx";
		reg = <0x35>;
		#sound-dai-cells = <1>;
	};
};

&sound {
	compatible = "qcom,sdm845-sndcard";
	model = "Razer Phone 2";
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&quat_mi2s_active &quat_mi2s_sd0_active &quat_mi2s_sd1_active>;
	audio-routing = "RX_BIAS", "MCLK", "DMIC1", "MIC BIAS1",
			"DMIC3", "MIC BIAS3", "DMIC5", "MIC BIAS4";

	mm1-dai-link {
		link-name = "MultiMedia1";
		cpu { sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA1>; };
	};
	mm2-dai-link {
		link-name = "MultiMedia2";
		cpu { sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA2>; };
	};
	speaker-dai-link {
		link-name = "Speaker Playback";
		cpu { sound-dai = <&q6afedai QUATERNARY_MI2S_RX>; };
		platform { sound-dai = <&q6routing>; };
		codec { sound-dai = <&aura_amp0 0>, <&aura_amp1 0>; };
	};
	slimcap-dai-link {
		link-name = "SLIM Capture 1";
		cpu { sound-dai = <&q6afedai SLIMBUS_0_TX>; };
		platform { sound-dai = <&q6routing>; };
		codec { sound-dai = <&wcd9340 1>; };
	};
};
