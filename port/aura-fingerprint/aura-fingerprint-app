#!/usr/bin/python3
"""On-phone enrollment and honest match-test UI. Runs as the desktop user."""
import re
import resource
import subprocess
import threading
import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, GLib


class Fingerprint(Gtk.Application):
    def __init__(self):
        super().__init__(application_id='org.aura.Fingerprint')
        self.worker = None
        self.mode = None
        self.total = 20
        self.final_message = False
        self.cancel_requested = False
        self.connect('activate', self.activate)

    def activate(self, _app):
        if hasattr(self, 'window'):
            self.window.present()
            return
        self.window = Gtk.ApplicationWindow(application=self)
        self.window.set_default_size(360, 620)
        self.window.set_title('Fingerprint')
        self.window.connect('delete-event', self.close)
        header = Gtk.HeaderBar(title='Fingerprint', show_close_button=True)
        self.window.set_titlebar(header)
        css = Gtk.CssProvider()
        css.load_from_data(b'window { font-size: 16px; } .title { font-size: 24px; font-weight: bold; } .dim-label { font-size: 13px; }')
        Gtk.StyleContext.add_provider_for_screen(self.window.get_screen(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        for side in ('top', 'bottom', 'start', 'end'):
            getattr(box, 'set_margin_' + side)(20)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.add(box)
        self.window.add(scroll)
        icon = Gtk.Image.new_from_file('/usr/share/icons/hicolor/scalable/apps/org.aura.Fingerprint.svg')
        box.pack_start(icon, False, False, 12)
        self.title = Gtk.Label(label='Add your fingerprint')
        self.title.get_style_context().add_class('title')
        box.pack_start(self.title, False, False, 0)
        self.detail = Gtk.Label(label='Use the sensor on the power button.\nRest your finger on it without clicking.')
        self.detail.set_line_wrap(True)
        self.detail.set_max_width_chars(30)
        self.detail.set_justify(Gtk.Justification.CENTER)
        box.pack_start(self.detail, False, False, 0)
        self.progress = Gtk.ProgressBar(show_text=True)
        self.progress.set_text('Ready')
        box.pack_start(self.progress, False, False, 0)
        self.enroll = Gtk.Button(label='Enroll fingerprint')
        self.enroll.get_style_context().add_class('suggested-action')
        self.enroll.connect('clicked', lambda *_: self.start('enroll'))
        self.setup = Gtk.Button(label='Set up secure enrollment')
        self.setup.connect('clicked', lambda *_: self.start('authorize'))
        self.verify = Gtk.Button(label='Test fingerprint')
        self.verify.connect('clicked', lambda *_: self.start('verify'))
        self.cancel = Gtk.Button(label='Cancel')
        self.cancel.connect('clicked', self.cancel_test)
        self.cancel.set_sensitive(False)
        for button in (self.setup, self.enroll, self.verify, self.cancel):
            button.set_size_request(-1, 48)
            box.pack_start(button, False, False, 0)
        note = Gtk.Label(label='Development preview\nFingerprint unlock is not enabled yet.\nYour PIN continues to work.')
        note.set_line_wrap(True)
        note.set_justify(Gtk.Justification.CENTER)
        note.get_style_context().add_class('dim-label')
        box.pack_end(note, False, False, 0)
        self.window.show_all()

    def start(self, mode):
        if self.worker is not None:
            return
        pin = None
        if mode in ('enroll', 'authorize'):
            dialog = Gtk.Dialog(title='Enrollment PIN', transient_for=self.window, modal=True)
            dialog.add_buttons('Cancel', Gtk.ResponseType.CANCEL, 'Continue', Gtk.ResponseType.OK)
            content = dialog.get_content_area()
            content.set_border_width(18)
            content.set_spacing(12)
            hint = Gtk.Label(label='Choose a PIN on first setup;\nuse that same PIN afterward.\nThis is separate from your screen-lock PIN.\nThe PIN is not saved.')
            hint.set_line_wrap(True)
            content.add(hint)
            entry = Gtk.Entry(visibility=False, input_purpose=Gtk.InputPurpose.PIN)
            entry.set_max_length(64)
            entry.set_activates_default(True)
            content.add(entry)
            dialog.set_default_response(Gtk.ResponseType.OK)
            dialog.show_all()
            entry.grab_focus()
            response = dialog.run()
            pin = entry.get_text()
            entry.set_text('')
            dialog.destroy()
            if response != Gtk.ResponseType.OK:
                return
            if not pin.isascii() or not pin.isdigit() or not 4 <= len(pin) <= 64:
                self.result('Check your PIN', 'Use 4–64 digits.', 'Not started', False)
                return
        self.mode = mode
        self.total = 20
        self.final_message = False
        self.cancel_requested = False
        self.progress.set_fraction(0)
        self.progress.set_text('Starting')
        self.title.set_text('Confirm with your PIN')
        self.detail.set_text('Approve the fingerprint test if asked.\nKeep your finger off the sensor for now.')
        for button in (self.setup, self.enroll, self.verify):
            button.set_sensitive(False)
        self.cancel.set_sensitive(True)
        self.worker = subprocess.Popen(['/usr/bin/pkexec', '/usr/local/libexec/aura-fingerprint-helper', mode],
                                       stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                       stderr=subprocess.STDOUT, text=True, bufsize=1)
        process = self.worker
        if pin is not None:
            try:
                process.stdin.write(pin + '\n')
                process.stdin.flush()
            except (BrokenPipeError, OSError):
                pass
            pin = None

        def read():
            for line in process.stdout:
                GLib.idle_add(self.update, line.strip())
            code = process.wait()
            GLib.idle_add(self.finished, code)
        threading.Thread(target=read, daemon=True).start()

    def update(self, line):
        if self.cancel_requested:
            return False
        if line.startswith('Lift finger,'):
            self.title.set_text('Lift your finger')
            self.detail.set_text('Take your finger off the sensor.\nShift it slightly for the next touch.')
        elif line.startswith('FINGER_LIFTED:'):
            self.title.set_text('Touch the sensor')
            self.detail.set_text('Cover the sensor with the pad of your finger.\nRest it gently; don’t click the button.')
        elif line.startswith('Enrollment sample '):
            match = re.fullmatch(r'Enrollment sample (\d+): status=(\d+) remaining=(\d+)', line)
            if match:
                status, remaining = int(match[2]), int(match[3])
                self.total = max(self.total, remaining + (1 if status == 1 else 0))
                fraction = max(0, min(1, 1 - remaining / self.total))
                self.progress.set_fraction(fraction)
                self.progress.set_text(f'{round(fraction * 100)}% recorded')
                self.detail.set_text('Good touch. Lift and move your finger slightly.' if status == 1 else
                                     'Try a slightly different finger position.')
        elif line.startswith('ENROLLMENT_SAVED:'):
            self.title.set_text('Checking saved fingerprint')
            self.detail.set_text('You can lift your finger now.')
        elif line == 'UI_ENROLLED':
            self.result('Fingerprint saved', 'Tap Test fingerprint and use the same finger.\nThen test a different finger to check rejection.', 'Saved', True)
        elif line == 'UI_AUTHORIZED':
            self.result('Secure enrollment is ready', 'PIN verification and fingerprint authorization passed.\nTap Enroll fingerprint to continue.', 'Ready to enroll', True)
        elif line == 'UI_MATCH':
            self.result('Fingerprint recognized', 'The saved fingerprint matched.\nNow try a different finger.', 'Match', True)
        elif line == 'UI_NO_MATCH':
            self.result('Fingerprint not recognized', 'This finger did not match the saved fingerprint.', 'No match', False)
        elif line.startswith('UI_ERROR:'):
            self.result('Test needs attention', line.partition(':')[2].strip(), 'Not completed', False)
        elif line == 'UI_CANCELLED':
            self.result('Test cancelled', 'You can start again when ready.', 'Cancelled', False)
        return False

    def result(self, title, detail, progress, complete):
        self.final_message = True
        self.title.set_text(title)
        self.detail.set_text(detail)
        self.progress.set_text(progress)
        if complete:
            self.progress.set_fraction(1)

    def finished(self, code):
        if self.cancel_requested:
            self.result('Test cancelled', 'You can start again when ready.', 'Cancelled', False)
        elif not self.final_message:
            self.result('Test not completed', 'Authentication was cancelled or the service could not finish. Try again.', 'Not completed', False)
        self.worker = None
        self.enroll.set_sensitive(True)
        self.setup.set_sensitive(True)
        self.verify.set_sensitive(True)
        self.cancel.set_sensitive(False)
        return False

    def cancel_test(self, *_):
        if self.worker is not None:
            self.cancel_requested = True
            self.title.set_text('Stopping test')
            self.detail.set_text('Lift your finger. The sensor is returning to idle.')
            self.cancel.set_sensitive(False)
            try:
                self.worker.stdin.write('cancel\n')
                self.worker.stdin.flush()
            except (BrokenPipeError, OSError):
                pass

    def close(self, *_):
        if self.worker is not None:
            self.cancel_test()
            return True
        return False


if __name__ == '__main__':
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    Fingerprint().run()
